# DeedGuard USA — backend environment (copy to Netlify env vars; never commit real values)

# --- Site ---
SITE_URL=https://deedguardusa.com
OPERATOR_EMAIL=rr@richardrosalaw.com

# --- Stripe (dashboard.stripe.com) ---
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Price IDs for each recurring plan (create Products -> Prices in Stripe, all monthly/recurring).
# Guardian ("defend") uses INTRO pricing: checkout at the founding price, then the webhook steps it
# up to the standard price after 12 months.
STRIPE_PRICE_ESSENTIAL=price_xxx        # Essential  $7.99/mo
STRIPE_PRICE_DEFEND_INTRO=price_xxx     # Guardian founding rate  $9.99/mo (first year)
STRIPE_PRICE_DEFEND=price_xxx           # Guardian standard/renewal  $17.95/mo
STRIPE_PRICE_PREMIER=price_xxx          # Premier  $24.99/mo

# --- Supabase (app/db/schema.sql) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxx

# --- Email alerts (resend.com) ---
RESEND_API_KEY=re_xxx
ALERT_FROM=DeedGuard USA <alerts@deedguardusa.com>

# --- Monitoring ---
# Which county adapter to use until real ones are wired (mock | fl-broward | ...)
COUNTY_ADAPTER=mock
